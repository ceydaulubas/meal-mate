{
  "name": "meal-mate",
  "version": "0.0.0",
  "private": true,
  "description": "MealMate — recipe discovery and collaborative meal planning.",
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint scripts && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/*.test.mjs && turbo run test",
    "test:db": "supabase test db",
    "test:db:isolated": "node scripts/test-db-isolated.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
